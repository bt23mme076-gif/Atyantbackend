{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "atyant-frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "C:/Atyantfrontend", "run", "dev", "--", "--port", "5173"],
      "port": 5173
