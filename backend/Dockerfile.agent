# AI mock interviewer worker (agent/interviewAgent.js).
# Debian slim, not Alpine: onnxruntime-node (Silero VAD) and @livekit/rtc-node
# ship glibc-only native binaries.
FROM node:20-slim
WORKDIR /app

# The LiveKit Rust SDK (@livekit/rtc-node) validates wss:// certificates against
# the OS trust store; node:slim ships without one, which fails with
# "no native root CA certificates found".
RUN apt-get update  && apt-get install -y --no-install-recommends ca-certificates  && rm -rf /var/lib/apt/lists/*

# Backend deps (models, utils, mongoose) — the agent imports them from ../
COPY package.json package-lock.json ./
RUN npm ci --omit=dev

# Agent-only deps (LiveKit agents, Silero, OpenAI SDK for Groq Whisper)
COPY agent/package.json agent/package-lock.json ./agent/
RUN cd agent && npm ci --omit=dev

COPY . .

USER node

CMD ["node", "agent/interviewAgent.js", "start"]
